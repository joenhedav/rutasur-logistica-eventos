# Copiá este archivo a .env para cambiar parámetros sin tocar el compose
AUTOSTART=true      # false = sin flujo continuo (necesario para la validación por lotes)
SIM_ACCEL=120       # 120 = 1 hora simulada cada 30 s reales (600 = validar más rápido)
SIM_RATE=20         # envíos por minuto
SIM_SEED=42         # semilla fija => corrida reproducible
